# Copy to .env for local development. Never commit the real .env.

# --- required in production -------------------------------------------------
SECRET_KEY=change-me-to-50-random-characters
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma separated, https:// added automatically if omitted
CSRF_TRUSTED_ORIGINS=

# --- database ---------------------------------------------------------------
# Leave unset for local SQLite. In production use a Postgres URL, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=
# DATABASE_SSL_REQUIRE=True

# --- site identity ----------------------------------------------------------
SITE_NAME=Insight
SITE_TAGLINE=Deep dives on computer science, physics and everything in between.
SITE_URL=http://localhost:8000
TIME_ZONE=UTC
PAGINATE_BY=9

# --- comments ---------------------------------------------------------------
# True = every comment waits for approval before it appears
COMMENT_MODERATION=False

# --- media ------------------------------------------------------------------
# Optional: Cloudinary's free tier keeps uploads off an ephemeral disk
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Django serves MEDIA_ROOT itself unless Cloudinary is configured. Set False if
# a CDN or web server handles /media/ for you.
# SERVE_MEDIA=True

# --- optional: real email instead of the console ----------------------------
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=an-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=you@gmail.com
